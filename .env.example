# ─── Supabase (from Project Settings → API) ───────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Razorpay (from Dashboard → Settings → API Keys) ──────────────
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# ─── Server-only secrets — NEVER put these in the app ─────────────
# Set these in Supabase via:
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxx
#   supabase secrets set RAZORPAY_KEY_SECRET=your_secret
# (SUPABASE_SERVICE_ROLE_KEY is auto-available in Edge Functions)
